{
  "name": "captionstitch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stitch video screenshots and their subtitles into one shareable image. Runs entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/standalone.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "emojibase-data": "^18.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.0.0"
  }
}
